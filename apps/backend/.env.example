# ============================================================
# Backend environment — copy to apps/backend/.env and fill in.
# Never commit real secrets. Defaults match docker-compose.yml.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
# Business timezone used by cron jobs and expiry calculation (BR-01)
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Allowed CORS origins: * or comma-separated list (mobile apps are not affected by CORS)
CORS_ORIGINS=*

# --- PostgreSQL (TypeORM) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dctl
DB_PASSWORD=dctl_dev_password
DB_NAME=dctl
DB_LOGGING=false

# --- Redis (BullMQ queues, Socket.IO adapter, AI cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (REST + WebSocket handshake) ---
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (<number><s|m|h|d>) and refresh token lifetime in days
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- AI / LLM (module ai, §8) ---
# mock | openai | anthropic | gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Hard timeout before falling back to rule-based suggestions (NFR §9: 15 s)
LLM_TIMEOUT_MS=15000
# Cache TTL for suggestions keyed by fridge snapshot hash (seconds)
AI_CACHE_TTL_SECONDS=600

# --- Push notifications (FR-10) ---
# console (log only) | expo (Expo push service; access token only if push security is enabled)
PUSH_PROVIDER=console
PUSH_EXPO_ACCESS_TOKEN=

# --- Email (FR-10) — MailHog in dev: SMTP 1025, web UI http://localhost:8025 ---
# console (log only) | smtp (dev: MailHog from docker-compose)
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Đi chợ Tiện lợi <no-reply@dctl.local>"
