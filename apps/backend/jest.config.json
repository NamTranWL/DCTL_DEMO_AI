{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }]
  },
  "collectCoverageFrom": ["**/*.ts", "!**/*.module.ts", "!main.ts", "!database/**"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node"
}
