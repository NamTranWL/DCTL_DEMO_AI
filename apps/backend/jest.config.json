{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.json"
      }
    ]
  },
  "collectCoverageFrom": ["**/*.ts", "!**/*.module.ts", "!main.ts", "!database/**"],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "coverageThreshold": {
    "**/modules/shopping/shopping.service.ts": {
      "statements": 80,
      "branches": 80,
      "functions": 80,
      "lines": 80
    },
    "**/modules/fridge/fridge.service.ts": {
      "statements": 80,
      "branches": 80,
      "functions": 80,
      "lines": 80
    },
    "**/modules/fridge/strategies/stock-deduction.strategy.ts": {
      "statements": 80,
      "branches": 80,
      "functions": 80,
      "lines": 80
    }
  }
}
