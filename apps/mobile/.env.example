# ============================================================
# Mobile environment — copy to apps/mobile/.env.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
# On a physical device / Android emulator, "localhost" is NOT your PC:
#   - Android emulator: http://10.0.2.2:3000
#   - Physical device:  http://<LAN IP of your PC>:3000
# ============================================================

# REST API base URL (API_URL)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Socket.IO server URL (WS_URL); namespace /realtime is appended by the client
EXPO_PUBLIC_WS_URL=http://localhost:3000
